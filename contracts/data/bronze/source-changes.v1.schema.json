{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bronze source-changes v1",
  "description": "Evidence-backed lifecycle event \u00d7 source entity \u00d7 observation. Absence in search is never deletion. Identity is SHA-256 of [dataset, platform, source ID, run ID, UTC collection time]; additional source fields survive in raw_payload. JSON fields are encoded strings. Technical timestamps use UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_platform",
    "source_record_id",
    "record_type",
    "source_url",
    "collected_at",
    "source_created_at",
    "source_updated_at",
    "collection_run_id",
    "query_id",
    "query_metadata",
    "raw_payload",
    "payload_hash",
    "retention_policy_id",
    "retention_expires_at",
    "artifact_uri",
    "change_type",
    "previous_payload_hash",
    "current_payload_hash",
    "previous_observation_id",
    "entity_record_type",
    "evidence_json",
    "ingested_at",
    "ingestion_metadata"
  ],
  "properties": {
    "schema_version": {
      "$ref": "observation.v1.schema.json#/$defs/schema_version"
    },
    "observation_id": {
      "$ref": "observation.v1.schema.json#/$defs/observation_id"
    },
    "source_platform": {
      "$ref": "observation.v1.schema.json#/$defs/source_platform"
    },
    "source_record_id": {
      "$ref": "observation.v1.schema.json#/$defs/source_record_id"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "Change"
      ]
    },
    "source_url": {
      "$ref": "observation.v1.schema.json#/$defs/source_url"
    },
    "collected_at": {
      "$ref": "observation.v1.schema.json#/$defs/collected_at"
    },
    "source_created_at": {
      "$ref": "observation.v1.schema.json#/$defs/source_created_at"
    },
    "source_updated_at": {
      "$ref": "observation.v1.schema.json#/$defs/source_updated_at"
    },
    "collection_run_id": {
      "$ref": "observation.v1.schema.json#/$defs/collection_run_id"
    },
    "query_id": {
      "$ref": "observation.v1.schema.json#/$defs/query_id"
    },
    "query_metadata": {
      "$ref": "observation.v1.schema.json#/$defs/query_metadata"
    },
    "raw_payload": {
      "$ref": "observation.v1.schema.json#/$defs/raw_payload"
    },
    "payload_hash": {
      "$ref": "observation.v1.schema.json#/$defs/payload_hash"
    },
    "retention_policy_id": {
      "$ref": "observation.v1.schema.json#/$defs/retention_policy_id"
    },
    "retention_expires_at": {
      "$ref": "observation.v1.schema.json#/$defs/retention_expires_at"
    },
    "artifact_uri": {
      "$ref": "observation.v1.schema.json#/$defs/artifact_uri"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "new",
        "changed",
        "deleted",
        "unavailable"
      ]
    },
    "previous_payload_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_payload_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_observation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "entity_record_type": {
      "type": "string"
    },
    "evidence_json": {
      "type": "string"
    },
    "ingested_at": {
      "$ref": "observation.v1.schema.json#/$defs/ingested_at"
    },
    "ingestion_metadata": {
      "$ref": "observation.v1.schema.json#/$defs/ingestion_metadata"
    }
  }
}
