{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bronze collection-runs v1",
  "description": "Source \u00d7 collection run. Query details and counters are retained in query_metadata/raw_payload. The current row is the latest terminal completion; earlier status projections remain readable in Delta history. Stable merge key is (source_platform, collection_run_id); record observations retain their separate run/time identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_platform",
    "source_record_id",
    "record_type",
    "source_url",
    "collected_at",
    "source_created_at",
    "source_updated_at",
    "collection_run_id",
    "query_id",
    "query_metadata",
    "raw_payload",
    "payload_hash",
    "retention_policy_id",
    "retention_expires_at",
    "artifact_uri",
    "started_at",
    "ended_at",
    "execution_status",
    "records_returned",
    "records_accepted",
    "records_rejected",
    "errors_json",
    "requests_json",
    "stopping_reason",
    "ingestion_metadata",
    "ingested_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "observation.v1.schema.json#/$defs/schema_version"
    },
    "observation_id": {
      "$ref": "observation.v1.schema.json#/$defs/observation_id"
    },
    "source_platform": {
      "$ref": "observation.v1.schema.json#/$defs/source_platform"
    },
    "source_record_id": {
      "$ref": "observation.v1.schema.json#/$defs/source_record_id"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "Run"
      ]
    },
    "source_url": {
      "$ref": "observation.v1.schema.json#/$defs/source_url"
    },
    "collected_at": {
      "$ref": "observation.v1.schema.json#/$defs/collected_at"
    },
    "source_created_at": {
      "$ref": "observation.v1.schema.json#/$defs/source_created_at"
    },
    "source_updated_at": {
      "$ref": "observation.v1.schema.json#/$defs/source_updated_at"
    },
    "collection_run_id": {
      "$ref": "observation.v1.schema.json#/$defs/collection_run_id"
    },
    "query_id": {
      "$ref": "observation.v1.schema.json#/$defs/query_id"
    },
    "query_metadata": {
      "$ref": "observation.v1.schema.json#/$defs/query_metadata"
    },
    "raw_payload": {
      "$ref": "observation.v1.schema.json#/$defs/raw_payload"
    },
    "payload_hash": {
      "$ref": "observation.v1.schema.json#/$defs/payload_hash"
    },
    "retention_policy_id": {
      "$ref": "observation.v1.schema.json#/$defs/retention_policy_id"
    },
    "retention_expires_at": {
      "$ref": "observation.v1.schema.json#/$defs/retention_expires_at"
    },
    "artifact_uri": {
      "$ref": "observation.v1.schema.json#/$defs/artifact_uri"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "records_returned": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "records_accepted": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "records_rejected": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "errors_json": {
      "type": "string"
    },
    "requests_json": {
      "type": [
        "string",
        "null"
      ]
    },
    "stopping_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingestion_metadata": {
      "$ref": "observation.v1.schema.json#/$defs/ingestion_metadata"
    },
    "ingested_at": {
      "$ref": "observation.v1.schema.json#/$defs/ingested_at"
    }
  }
}
