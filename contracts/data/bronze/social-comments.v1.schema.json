{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bronze social-comments v1",
  "description": "Source comment/reply \u00d7 collection observation, with explicit parent evidence. Identity is SHA-256 of [dataset, platform, source ID, run ID, UTC collection time]; additional source fields survive in raw_payload. JSON fields are encoded strings. Technical timestamps use UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_platform",
    "source_record_id",
    "record_type",
    "source_url",
    "collected_at",
    "source_created_at",
    "source_updated_at",
    "collection_run_id",
    "query_id",
    "query_metadata",
    "raw_payload",
    "payload_hash",
    "retention_policy_id",
    "retention_expires_at",
    "artifact_uri",
    "native_comment_id",
    "native_post_id",
    "parent_comment_id",
    "comment_text_raw",
    "published_at",
    "updated_at",
    "is_reply",
    "ingested_at",
    "ingestion_metadata"
  ],
  "properties": {
    "schema_version": {
      "$ref": "observation.v1.schema.json#/$defs/schema_version"
    },
    "observation_id": {
      "$ref": "observation.v1.schema.json#/$defs/observation_id"
    },
    "source_platform": {
      "$ref": "observation.v1.schema.json#/$defs/source_platform"
    },
    "source_record_id": {
      "$ref": "observation.v1.schema.json#/$defs/source_record_id"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "Comment"
      ]
    },
    "source_url": {
      "$ref": "observation.v1.schema.json#/$defs/source_url"
    },
    "collected_at": {
      "$ref": "observation.v1.schema.json#/$defs/collected_at"
    },
    "source_created_at": {
      "$ref": "observation.v1.schema.json#/$defs/source_created_at"
    },
    "source_updated_at": {
      "$ref": "observation.v1.schema.json#/$defs/source_updated_at"
    },
    "collection_run_id": {
      "$ref": "observation.v1.schema.json#/$defs/collection_run_id"
    },
    "query_id": {
      "$ref": "observation.v1.schema.json#/$defs/query_id"
    },
    "query_metadata": {
      "$ref": "observation.v1.schema.json#/$defs/query_metadata"
    },
    "raw_payload": {
      "$ref": "observation.v1.schema.json#/$defs/raw_payload"
    },
    "payload_hash": {
      "$ref": "observation.v1.schema.json#/$defs/payload_hash"
    },
    "retention_policy_id": {
      "$ref": "observation.v1.schema.json#/$defs/retention_policy_id"
    },
    "retention_expires_at": {
      "$ref": "observation.v1.schema.json#/$defs/retention_expires_at"
    },
    "artifact_uri": {
      "$ref": "observation.v1.schema.json#/$defs/artifact_uri"
    },
    "native_comment_id": {
      "type": "string",
      "minLength": 1
    },
    "native_post_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_comment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "comment_text_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "is_reply": {
      "type": "boolean"
    },
    "ingested_at": {
      "$ref": "observation.v1.schema.json#/$defs/ingested_at"
    },
    "ingestion_metadata": {
      "$ref": "observation.v1.schema.json#/$defs/ingestion_metadata"
    }
  }
}
