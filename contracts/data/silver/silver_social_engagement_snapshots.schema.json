      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "comments": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "shares": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "reposts": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "quotes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "replies": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
