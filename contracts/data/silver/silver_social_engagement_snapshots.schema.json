        "number",
        "null"
      ]
    },
    "delta_views": {
      "type": [
        "integer",
        "null"
      ]
    },
    "delta_likes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "delta_comments": {
      "type": [
        "integer",
        "null"
      ]
    },
    "delta_shares": {
      "type": [
        "integer",
        "null"
      ]
    },
