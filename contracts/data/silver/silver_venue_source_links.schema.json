{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "silver_venue_source_links",
  "description": "Grain: source entity to canonical venue. See docs/data/silver_gold_metric_definitions.md for lineage, denominators and completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_platform",
    "source_record_id",
    "record_type",
    "venue_id",
    "first_seen_at",
    "last_seen_at",
    "match_method",
    "evidence_ids",
    "schema_version",
    "processing_version",
    "lineage_ids"
  ],
  "properties": {
    "source_platform": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "record_type": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "match_method": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "3"
    },
    "processing_version": {
      "type": "string"
    },
    "lineage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
