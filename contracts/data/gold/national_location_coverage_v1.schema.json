{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "national_location_coverage_v1",
  "description": "Grain: location x version x source x observed collection day. See docs/data/silver_gold_metric_definitions.md for lineage, denominators and completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admin_unit_id",
    "admin_version",
    "source_platform",
    "period_start",
    "period_end",
    "planned_queries",
    "successful_queries",
    "failed_queries",
    "records_returned",
    "records_accepted",
    "resolved_records",
    "last_success_at",
    "collection_status",
    "query_success_rate",
    "geo_resolution_rate",
    "query_evidence_status",
    "collection_run_ids",
    "schema_version",
    "processing_version",
    "lineage_ids",
    "generated_at",
    "metric_definition_id",
    "completeness_status",
    "source_platforms"
  ],
  "properties": {
    "admin_unit_id": {
      "type": "string"
    },
    "admin_version": {
      "type": "string"
    },
    "source_platform": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "planned_queries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "successful_queries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failed_queries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "records_returned": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "records_accepted": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "resolved_records": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "last_success_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collection_status": {
      "type": "string"
    },
    "query_success_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "geo_resolution_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "query_evidence_status": {
      "type": "string"
    },
    "collection_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "processing_version": {
      "type": "string"
    },
    "lineage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metric_definition_id": {
      "type": "string"
    },
    "completeness_status": {
      "type": "string"
    },
    "source_platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
