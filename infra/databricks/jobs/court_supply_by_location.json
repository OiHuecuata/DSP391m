{
  "run_name": "dsp391-court-supply-by-location",
  "tasks": [
    {
      "task_key": "build_court_supply_by_location",
      "existing_cluster_id": "${DATABRICKS_CLUSTER_ID}",
      "python_wheel_task": {
        "package_name": "dsp391-spark-jobs",
        "entry_point": "court_supply_by_location",
        "parameters": [
          "--lakehouse-base-uri",
          "${DSP_LAKEHOUSE_BASE_URI}",
          "--courts-path",
          "${DSP_DELTA_COURTS_PATH}",
          "--gold-path",
          "${DSP_DELTA_COURT_SUPPLY_BY_LOCATION_PATH}",
          "--quality-path",
          "${DSP_DELTA_UNRESOLVED_COURT_LOCATIONS_PATH}"
        ]
      },
      "libraries": [
        {
          "whl": "${DSP_DATABRICKS_WHEEL_URI}"
        }
      ]
    }
  ]
}
