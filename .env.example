# Latest descriptive Gold snapshot; inclusive rolling social window.
DSP_MARKET_SIGNAL_WINDOW_DAYS=30
# Optional YYYY-MM-DD override; required when social Gold is empty.
# DSP_MARKET_SIGNAL_END_DATE=2026-10-05
# DSP_DELTA_LOCATION_MARKET_SIGNAL_SNAPSHOT_PATH=s3a://your-bucket/lake/gold/location_market_signal_snapshot

# Local ClickHouse HTTP serving connection (export for Python and Go commands).
# Empty password is allowed for loopback-only development; set it for other use.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dsp391m
CLICKHOUSE_USER=dsp391m
CLICKHOUSE_PASSWORD=
# SERVER_PORT=8080

# Airflow 3 local orchestration; separate metadata DB, no cloud prerequisite.
AIRFLOW_PORT=8081
AIRFLOW_METADATA_PASSWORD=airflow-local-only
AIRFLOW_LOCAL_USERNAME=admin
# Optional initial UI password; omitted generates a local password file.
# AIRFLOW_LOCAL_PASSWORD=choose-a-development-password
# AIRFLOW_UID=1000  # Make commands use your current host UID automatically.
# Manual-only by default. Set @daily to opt into scheduled batch refreshes.
DSP_AIRFLOW_SCHEDULE=
DSP_AIRFLOW_PBPLUS_MODE=replay
# Saved Bronze/crawler envelope; paths relative to the repository also work.
DSP_AIRFLOW_PBPLUS_REPLAY=
DSP_AIRFLOW_PBPLUS_GEOGRAPHY=
